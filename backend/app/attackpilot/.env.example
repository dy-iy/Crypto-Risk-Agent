# Copy these keys into backend/.env, not this package directory.
# The preparation script imports the supplied archive's chain credentials without
# overwriting existing values. It does not import an old model key.
DEEPSEEK_API_KEY=
# AttackPilot uses deepseek-flash independently of the shared DEEPSEEK_MODEL.
ATTACKPILOT_RPC_URLS='{"Ethereum":[],"BNBChain":[]}'
ATTACKPILOT_SCAN_URLS='{"Ethereum":[],"BNBChain":[]}'
ATTACKPILOT_WEB3_PROVIDER=
ATTACKPILOT_TENDERLY_API_KEY=
ATTACKPILOT_TENDERLY_ACCOUNT=
ATTACKPILOT_TENDERLY_PROJECT=
ATTACKPILOT_MAX_TASKS=1
ATTACKPILOT_TASK_TIMEOUT=3600
ATTACKPILOT_LLM_TIMEOUT=600
ATTACKPILOT_LLM_READ_TIMEOUT=120
ATTACKPILOT_NODE_PATH=node
# Public Data Feeds: no Chainlink account, API key, wallet, or LINK required.
# Uses ATTACKPILOT_RPC_URLS; covered feeds with missing evidence stay unpriced.
ATTACKPILOT_CHAINLINK_ENABLED=1
ATTACKPILOT_CHAINLINK_TOTAL_TIMEOUT_SECONDS=30
ATTACKPILOT_CHAINLINK_REQUEST_TIMEOUT_SECONDS=8
ATTACKPILOT_CHAINLINK_MAX_RPC_CALLS=64
ATTACKPILOT_CHAINLINK_MAX_HISTORY_ROUNDS=32
ATTACKPILOT_CHAINLINK_MAX_PHASES=8
# Optional exact platform/token mappings merged with ETH/WETH and BNB/WBNB.
ATTACKPILOT_CHAINLINK_FEEDS='{}'
