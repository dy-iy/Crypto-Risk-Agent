# Copy these keys into backend/.env, not this package directory.
# The preparation script imports the supplied archive's chain credentials without
# overwriting existing values. It does not import an old model key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
ATTACKPILOT_RPC_URLS='{"Ethereum":[],"BNBChain":[]}'
ATTACKPILOT_SCAN_URLS='{"Ethereum":[],"BNBChain":[]}'
ATTACKPILOT_WEB3_PROVIDER=
ATTACKPILOT_TENDERLY_API_KEY=
ATTACKPILOT_TENDERLY_ACCOUNT=
ATTACKPILOT_TENDERLY_PROJECT=
ATTACKPILOT_MAX_TASKS=1
ATTACKPILOT_TASK_TIMEOUT=3600
ATTACKPILOT_LLM_TIMEOUT=600
ATTACKPILOT_LLM_READ_TIMEOUT=120
ATTACKPILOT_NODE_PATH=node
