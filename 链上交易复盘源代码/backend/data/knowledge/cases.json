    {
      "case_id": "external_parity_wallet_multisig_2017",
      "name": "Parity Wallet MultiSig Hack",
      "source_kind": "external_learning_case",
      "dataset_file": null,
      "vulnerability_type_ids": ["delegatecall_misuse", "access_control"],
      "platform": "Ethereum",
      "time": "2017-07-19",
      "loss": "153,037 ETH (~$30M)",
      "root_cause": "Wallet fallback used catch-all delegatecall to WalletLibrary; public initWallet could be called after deployment and rewrote multisig ownership.",
      "transaction_hashes": [],
      "attacker_address": "0xb3764761e297d6f121e79c32a65829cd1ddb4d32",
      "report_link": "https://www.openzeppelin.com/news/on-the-parity-wallet-multisig-hack-405a8c12e8f7",
      "learning_summary": "攻击者对每个受影响钱包发起两笔交易：先调用 WalletLibrary.initWallet，通过 delegatecall 在钱包本体 storage 中把 m_owners 改成只包含攻击者且 required=1；随后调用 execute，把钱包资金转出。",
      "attack_path": [
        "钱包 fallback 将未知 calldata delegatecall 到 WalletLibrary",
        "WalletLibrary.initWallet 是 public，且缺少已初始化保护",
        "攻击者构造 initWallet(owner=attacker, required=1) 改写钱包本体 owner 状态",
        "攻击者作为唯一 owner 调用 execute 转走资金"
      ],
      "patch_lessons": [
        "不要把构造函数初始化逻辑暴露成可被 delegatecall 命中的 public 函数",
        "不要使用 catch-all delegatecall 作为通用外部转发机制",
        "显式定义钱包合约允许外部调用的库函数 selector",
        "initializer 必须只能执行一次，并保护 owner/admin 等关键 storage 写入"
      ],
      "tracepilot_learning_value": "适合作为 Ethernaut Delegation 的真实世界案例，用来训练 Agent 识别 delegatecall 的 storage context、初始化函数暴露和权限状态改写。",
      "manual_review_status": "external_reference_reviewed"
    }
