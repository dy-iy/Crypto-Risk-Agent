# Local/server Vite development.
# Leave these empty/commented to use same-origin Vite proxy:
# browser -> http://SERVER_IP:5173/api -> Vite proxy -> backend localhost:8000
# browser -> ws://SERVER_IP:5173/ws -> Vite proxy -> backend localhost:8000

# Optional direct-backend mode. Replace SERVER_IP with your server public IP.
# VITE_BACKEND_HTTP_URL=http://SERVER_IP:8000
# VITE_BACKEND_WS_URL=ws://SERVER_IP:8000
